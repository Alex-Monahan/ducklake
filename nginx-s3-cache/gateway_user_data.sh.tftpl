#!/bin/bash
set -euo pipefail

# Install Docker
dnf -y update
dnf -y install docker
systemctl enable --now docker

# Use fast local NVMe (instance store) for the cache when present, else root disk.
CACHE_DIR=/var/cache/nginx
if lsblk -dno NAME | grep -q nvme1n1; then
  mkfs.xfs -f /dev/nvme1n1
  mkdir -p "$CACHE_DIR"
  mount /dev/nvme1n1 "$CACHE_DIR"
fi
mkdir -p "$CACHE_DIR"

# nginx-s3-gateway config. No static AWS keys: the EC2 instance role is used.
cat >/etc/s3gw.env <<EOF
S3_BUCKET_NAME=${s3_bucket}
S3_REGION=${s3_region}
S3_SERVER=${s3_server}
S3_SERVER_PORT=443
S3_SERVER_PROTO=https
S3_STYLE=virtual-v2
S3_SERVICE=s3
AWS_SIGS_VERSION=4
AWS_REGION=${s3_region}
ALLOW_DIRECTORY_LIST=false
PROVIDE_INDEX_PAGE=false
PROXY_CACHE_MAX_SIZE=${cache_max_size}
PROXY_CACHE_SLICE_SIZE=${cache_slice_size}
PROXY_CACHE_INACTIVE=30d
PROXY_CACHE_VALID_OK=30d
PROXY_CACHE_VALID_NOTFOUND=1m
PROXY_CACHE_VALID_FORBIDDEN=30s
EOF

docker run -d --restart always \
  --name nginx-s3-gateway \
  --env-file /etc/s3gw.env \
  -p 80:80 \
  -v "$CACHE_DIR":/var/cache/nginx \
  ${gateway_image}
